<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the Windows-only projects compile on macOS/Linux build machines too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.1.1</Version>
    <Product>PowerLens</Product>
    <Company>PowerLens</Company>
  </PropertyGroup>
</Project>
