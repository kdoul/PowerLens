<Window x:Class="PowerLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PowerLens.App.Controls"
        Title="PowerLens — battery &amp; charger"
        Width="1080" Height="860" MinWidth="820" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/PowerLens.ico"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="200" />
            <RowDefinition Height="3*" MinHeight="240" />
        </Grid.RowDefinitions>

        <!-- Update available -->
        <Border x:Name="UpdateBar" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12" Visibility="Collapsed"
                BorderBrush="{DynamicResource Accent}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateNowButton" Content="Update now" Style="{StaticResource GlassButton}" Click="OnUpdateNow" />
                    <Button Content="What's new" Style="{StaticResource GlassButton}" Click="OnReleaseNotes" />
                    <Button x:Name="UpdateLaterButton" Content="Later" Style="{StaticResource GlassButton}" Margin="0" Click="OnUpdateLater" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="UpdateBarText" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateBarProgress" Style="{StaticResource SlimProgress}" Maximum="1" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Header cards -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62*" />
                <ColumnDefinition Width="38*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="POWER ADAPTER" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="AdapterWatts" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="42" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock x:Name="AdapterCaption" Text="Reading…" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock x:Name="AdapterDetail" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Border x:Name="StatusPill" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Margin="0,10,0,0" Background="Gray">
                        <TextBlock x:Name="StatusText" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="BATTERY" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="BatteryPercent" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="42" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <ProgressBar x:Name="BatteryLevel" Style="{StaticResource SlimProgress}" Maximum="100" Margin="0,2,0,8" />
                    <TextBlock x:Name="BatteryCaption" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock x:Name="BatteryDetail" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Live chart -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
            <controls:PowerChartView x:Name="Chart" />
        </Border>

        <!-- Tabs -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
            <TabControl x:Name="Tabs" Style="{StaticResource PillTabs}">
                <TabItem Header="Charger">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChargerRows" ItemTemplate="{StaticResource RowGroupTemplate}" Focusable="False" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Battery">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BatteryRows" ItemTemplate="{StaticResource RowGroupTemplate}" Focusable="False" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Adapter test">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4" MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock x:Name="TestInstruction" FontSize="15" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,14">
                                <Button x:Name="TestStart" Content="Start test" Style="{StaticResource GlassButton}" Click="OnStartTest" />
                                <Button x:Name="TestCancel" Content="Cancel" Style="{StaticResource GlassButton}" Click="OnCancelTest" IsEnabled="False" />
                            </StackPanel>
                            <ProgressBar x:Name="TestProgress" Style="{StaticResource SlimProgress}" Maximum="1" Width="440" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TestHeadline" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,0" />
                            <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Raw data">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,10">
                            <Button Content="Copy report" Style="{StaticResource GlassButton}" Click="OnCopyReport" />
                            <Button Content="Save report…" Style="{StaticResource GlassButton}" Click="OnSaveReport" />
                            <Button x:Name="RescanButton" Content="Rescan WMI" Style="{StaticResource GlassButton}" Click="OnRescan" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RawRows" ItemTemplate="{StaticResource RowGroupTemplate}" Focusable="False" />
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="SettingsTab" Header="Settings">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6" MaxWidth="680" HorizontalAlignment="Left">
                            <CheckBox x:Name="SettingTray" Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged">
                                <StackPanel>
                                    <TextBlock Text="Show icon in the system tray" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Live status and quick options from the notification area. Right-click the icon for its menu." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="SettingTrayWatts" Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged">
                                <StackPanel>
                                    <TextBlock Text="Show live watts in the tray icon" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Green while charging, slate while discharging, red when the charger is too weak." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="SettingCloseToTray" Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged">
                                <StackPanel>
                                    <TextBlock Text="Close button hides PowerLens to the tray" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Keeps monitoring in the background. Use Exit in the tray menu to quit." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="SettingStartup" Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Starts quietly in the tray when you sign in (or as a window if the tray icon is off)." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="SettingUpdates" Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged">
                                <StackPanel>
                                    <TextBlock Text="Check for updates automatically" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Asks GitHub about once a day whether a newer release exists. Nothing about your PC is sent." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="54,0,0,0">
                                <Button x:Name="CheckUpdatesButton" Content="Check now" Style="{StaticResource GlassButton}" Click="OnCheckUpdates" />
                                <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
